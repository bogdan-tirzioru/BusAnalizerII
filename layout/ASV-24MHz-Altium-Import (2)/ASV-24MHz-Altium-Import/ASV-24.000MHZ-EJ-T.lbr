<smd name="4" x="-2.54" y="2.0" dx="1.8" dy="2.0" layer="1" rot="R0"/>
<wire x1="-3.5" y1="-2.54" x2="3.5" y2="-2.54" width="0.15" layer="21"/>
<wire x1="3.5" y1="-2.54" x2="3.5" y2="2.54" width="0.15" layer="21"/>
<wire x1="3.5" y1="2.54" x2="-3.5" y2="2.54" width="0.15" layer="21"/>
