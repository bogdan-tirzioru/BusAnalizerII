<devicesets>
<deviceset name="ASV-24.000MHZ-EJ-T" prefix="X" uservalue="yes">
<description>Abracon ASV 24.000 MHz 3.3 V HCMOS oscillator. Pin 1 EN is active high: high or open enables output; low tri-states output. Pin 2 GND/case, pin 3 output, pin 4 VDD.</description>
<gates>
<gate name="G$1" symbol="ASV_OSCILLATOR" x="0" y="0"/>
</gates>
<devices>
<device name="" package="ASV_7x5.08mm">
<connects>
<connect gate="G$1" pin="EN" pad="1"/>
<connect gate="G$1" pin="GND" pad="2"/>
<connect gate="G$1" pin="OUT" pad="3"/>
<connect gate="G$1" pin="VDD" pad="4"/>
</connects>
<technologies><technology name=""/></technologies>
</device>
</devices>
</deviceset>
</devicesets>
