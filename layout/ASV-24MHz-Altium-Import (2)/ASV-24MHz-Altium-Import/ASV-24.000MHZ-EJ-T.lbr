<package name="ASV_7x5.08mm">
<description>Abracon ASV SMD HCMOS oscillator. Package 7.0 x 5.08 x 1.8 mm. Recommended land pattern from datasheet: four 1.8 x 2.0 mm pads, 5.08 mm x 4.0 mm pitch.</description>
<smd name="1" x="-2.54" y="-2.0" dx="1.8" dy="2.0" layer="1" rot="R0"/>
<smd name="2" x="2.54" y="-2.0" dx="1.8" dy="2.0" layer="1" rot="R0"/>
