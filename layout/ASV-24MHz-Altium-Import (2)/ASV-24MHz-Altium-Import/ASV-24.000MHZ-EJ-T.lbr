<text x="0" y="3.25" size="1" layer="25" align="center">&gt;NAME</text>
<text x="0" y="-3.35" size="1" layer="27" align="center">&gt;VALUE</text>
</package>
</packages>
<symbols>
<symbol name="ASV_OSCILLATOR">
<wire x1="-5.08" y1="5.08" x2="5.08" y2="5.08" width="0.254" layer="94"/>
<wire x1="5.08" y1="5.08" x2="5.08" y2="-5.08" width="0.254" layer="94"/>
