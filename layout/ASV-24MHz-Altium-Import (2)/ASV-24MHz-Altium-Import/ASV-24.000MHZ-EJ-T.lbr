<text x="0" y="-1.27" size="1.27" layer="96" align="center">&gt;VALUE</text>
<pin name="EN" x="-10.16" y="2.54" length="middle" direction="in" rot="R0" function="dot"/>
<pin name="GND" x="-10.16" y="-2.54" length="middle" direction="sup" rot="R0" function="dot"/>
<pin name="OUT" x="10.16" y="-2.54" length="middle" direction="out" rot="R180" function="dot"/>
<pin name="VDD" x="10.16" y="2.54" length="middle" direction="sup" rot="R180" function="dot"/>
</symbol>
